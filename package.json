{
  "name": "estadistica-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Solucionador paso a paso de regresión lineal y probabilidad (Estadística, Universidad del Cauca)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "vite-node validation/exportar_ejemplos.ts && python3 validation/generar_fixtures.py",
    "build:artifact": "vite build --config vite.config.artifact.ts && node scripts/fragmento-artifact.mjs",
    "build:usb": "vite build --config vite.config.artifact.ts && node scripts/empaquetar-usb.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "fflate": "0.8.2",
    "jstat": "^1.9.6",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "22.19.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "mathjs": "^13.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  }
}
